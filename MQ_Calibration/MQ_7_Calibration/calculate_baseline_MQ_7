import pandas as pd

CSV_FILENAME = "MQ7_clean_air.csv"

# Number of initial rows to ignore
# Increase this if the sensor was still stabilizing
ROWS_TO_SKIP = 00

df = pd.read_csv(CSV_FILENAME)

required_columns = [
    "raw_adc",
    "adc_voltage",
    "module_voltage"
]

for column in required_columns:
    df[column] = pd.to_numeric(
        df[column],
        errors="coerce"
    )

df = df.dropna(subset=required_columns)

stable_data = df.iloc[ROWS_TO_SKIP:].copy()

print("File:", CSV_FILENAME)
print("Total valid samples:", len(df))
print("Samples used:", len(stable_data))

print("\nRAW ADC")
print("Average:", stable_data["raw_adc"].mean())
print("Minimum:", stable_data["raw_adc"].min())
print("Maximum:", stable_data["raw_adc"].max())
print("Standard deviation:", stable_data["raw_adc"].std())

print("\nESP32 ADC VOLTAGE")
print("Average:", stable_data["adc_voltage"].mean())

print("\nRECONSTRUCTED MODULE VOLTAGE")
print("Average:", stable_data["module_voltage"].mean())
average = stable_data["raw_adc"].mean()
standard_deviation = stable_data["raw_adc"].std()

noise_percentage = (
    standard_deviation / average
) * 100

print("Noise percentage:", noise_percentage, "%")